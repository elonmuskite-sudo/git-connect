# Appwrite
VITE_APPWRITE_ENDPOINT=https://your-appwrite-endpoint/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id

# Server-only: required by schema provisioning scripts; never use a VITE_ prefix.
APPWRITE_ENDPOINT=https://your-appwrite-endpoint/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_API_KEY=your_appwrite_api_key

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only PostgreSQL URL used by the explicit migration CLI; never use a VITE_ prefix.
SUPABASE_DB_URL=postgresql://postgres:your-password@host:5432/postgres

# Server-side email delivery through the Resend API; do not expose this key to the browser.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=admin@nexus-chat-world.com

# Server-only admin values for schema provisioning.
ADMIN_EMAIL=admin@nexus-chat-world.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_MEMBER_ID=1000000000
